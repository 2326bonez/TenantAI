PORT=3000
NODE_ENV=development
OPENAI_API_KEY=your_api_key_here
# Clerk browser key; safe to expose through the Vite client bundle.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Clerk server secret; never expose this to the browser.
CLERK_SECRET_KEY=sk_test_...
# Optional server-side Clerk publishable key, if required by the selected Clerk setup.
# CLERK_PUBLISHABLE_KEY=pk_test_...
# Required before secure case/document persistence:
# DATABASE_URL=your_database_connection_string
# STORAGE_BUCKET=your_private_storage_bucket
